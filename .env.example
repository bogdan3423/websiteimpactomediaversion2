# Canonical URLs, the sitemap and structured data always use https://impactomedia.ro.
# Indexing is only switched off deliberately (see src/lib/indexing.ts):
#   - SEO_NOINDEX=true on any staging host, or
#   - automatically on Netlify deploy previews / branch deploys and Vercel previews.
SEO_NOINDEX=false

# Optional search engine ownership tokens (content attribute of the meta tag only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
